# Contact + feedback form delivery (app/api/contact/route.ts)
#
# Without RESEND_API_KEY the forms stay up but return a friendly
# "temporarily unavailable" message instead of silently losing enquiries.
#
# 1. Create an account at https://resend.com
# 2. Verify the easycards.co.nz domain (Resend will not send from an
#    unverified domain — this is what stops your mail landing in spam)
# 3. Create an API key and set it in Vercel:
#      vercel env add RESEND_API_KEY
RESEND_API_KEY=

# Where enquiries are delivered. Defaults to admin@easycards.co.nz.
CONTACT_TO_EMAIL=admin@easycards.co.nz

# The From address. Must be on a domain verified in Resend.
CONTACT_FROM_EMAIL=website@easycards.co.nz
